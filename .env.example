# Cookies pour YouTube (vidéos age-restricted)
# Exporter vos cookies YouTube avec une extension navigateur comme "Get cookies.txt"
# Placez le fichier dans le répertoire cookies/ et mettez à jour ce chemin
# YOUTUBE_COOKIES_PATH=./cookies/youtube.txt

# Cookies pour Instagram 
# Exporter vos cookies Instagram avec une extension navigateur comme "Get cookies.txt"
# Placez le fichier dans le répertoire cookies/ (fichier par défaut : instagram.txt)
# INSTAGRAM_COOKIES_PATH=./cookies/instagram.txt

# Autres configurations
# NODE_ENV=production

# Page d'administration (/admin.html) pour téléverser les cookies YouTube/Instagram
# depuis le navigateur. Tant que ces deux valeurs ne sont pas définies, la page est désactivée.
# 1. Générer le hash : node scripts/hash-password.js "mon-mot-de-passe"
# 2. Générer un secret aléatoire pour SESSION_SECRET, par ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=
